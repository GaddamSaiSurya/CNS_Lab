import javax.crypto.Cipher;
import javax.crypto.spec.SecretKeySpec;
import java.util.Base64;
import java.util.Scanner;

public class RijndaelExample {

    public static void main(String[] args) throws Exception {

        Scanner sc = new Scanner(System.in);

        SecretKeySpec key = new SecretKeySpec(
                "0123456789abcdef".getBytes("UTF-8"), "AES");

        Cipher c = Cipher.getInstance("AES/ECB/PKCS5Padding");

        System.out.print("Enter Plain Text: ");
        String msg = sc.nextLine();

        c.init(Cipher.ENCRYPT_MODE, key);

        String enc = Base64.getEncoder().encodeToString(
                c.doFinal(msg.getBytes("UTF-8")));

        System.out.println("Original Text: " + msg);
        System.out.println("Encrypted Text: " + enc);

        c.init(Cipher.DECRYPT_MODE, key);

        String dec = new String(
                c.doFinal(Base64.getDecoder().decode(enc)), "UTF-8");

        System.out.println("Decrypted Text: " + dec);

        sc.close();
    }
}
