import java.util.Scanner;

public class DiffieHellmankeyexchange {

    static long pow(long b, int e, int p) {
        long r = 1;
        b %= p;

        while (e > 0) {
            if ((e & 1) == 1) {
                r = r * b % p;
            }

            b = b * b % p;
            e >>= 1;
        }

        return r;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int p = 23;
        int g = 5;

        System.out.print("Enter private key of a: ");
        int a = sc.nextInt();

        System.out.print("Enter private key of b: ");
        int b = sc.nextInt();

        long pa = pow(g, a, p);
        long pb = pow(g, b, p);

        long ka = pow(pb, a, p);
        long kb = pow(pa, b, p);

        System.out.println("Public prime " + p);
        System.out.println("Public generator " + g);

        System.out.println("Alice public key is " + pa);
        System.out.println("Bobs public key is " + pb);

        System.out.println("Shared key of Alice " + ka);
        System.out.println("Shared key of Bob " + kb);

        System.out.println(ka == kb
                ? "Key exchange successful!"
                : "Key exchange failure");

        sc.close();
    }
}
